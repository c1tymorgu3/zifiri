root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ex,exs,heex,eex,ts,tsx,js,mjs,json,yml,yaml,css,html}]
indent_size = 2

[Makefile]
indent_style = tab
indent_size = unset

[*.md]
trim_trailing_whitespace = false
