# zifiri — tor configuration (onion service). plan §11.3, §12 (onion module)
#
# The container shares nginx's network namespace (network_mode: "service:nginx"),
# so 127.0.0.1 here really is loopback: tor connects to nginx over TCP
# without leaving the machine.
#
# NOTHING IS LOGGED: `Log notice stdout` — output goes to the container's stdout,
# and since compose uses `logging.driver: none` it is written nowhere.
# No logging to a file.

# --- SOCKS (outbound) -----------------------------------------------------
# zifiri itself makes no outbound calls; 9050 is only for operator diagnostics,
# locked to loopback. Not exposed externally, not published.
SocksPort 127.0.0.1:9050
SocksPolicy accept 127.0.0.1
SocksPolicy reject *

# The control port is CLOSED. An open control port makes tor remotely
# manageable and, with a default password, forms a serious surface. The image's
# own healthcheck is therefore disabled; the healthcheck in compose
# looks at the hostname file.
ControlPort 0

# --- general --------------------------------------------------------------
DataDirectory /var/lib/tor
Log notice stdout
SafeLogging 1
# Rule: minimize disk writes. Nothing persistent except the onion key.
AvoidDiskWrites 1
ClientUseIPv6 0

# --- onion service (v3) ---------------------------------------------------
HiddenServiceDir /var/lib/tor/hidden_service
HiddenServiceVersion 3
# Tor → nginx. This address is nginx's onion listener (nginx.conf: 127.0.0.1:8081).
HiddenServicePort 80 127.0.0.1:8081

# Intro-point DoS defense and PoW. The network-layer counterpart of the PoW
# logic in plan §4.4: the client does work before building a circuit.
HiddenServiceEnableIntroDoSDefense 1
HiddenServicePoWDefensesEnabled 1

# Number of streams that can be opened in the same circuit: the chat WebSocket
# holds a single stream; a client opening parallel streams is abnormal by definition.
HiddenServiceMaxStreams 10
HiddenServiceMaxStreamsCloseCircuit 1
