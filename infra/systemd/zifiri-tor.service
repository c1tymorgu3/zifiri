# zifiri — onion service (tor). plan §11.3, §5.1.
#
# torrc lives in the repo (infra/tor/config/torrc): DataDirectory /var/lib/tor,
# HiddenServicePort 80 → 127.0.0.1:8081 (nginx), ControlPort 0, Log notice
# stdout. stdout goes to the journal; since journald has Storage=none nothing is
# written anywhere (harden.sh step 5). This unit is the last link in that chain:
# it does not open a log file, and if one is opened there is nowhere to write.
#
# Debian/Ubuntu: the tor package's user is `debian-tor`. On RHEL/Alpine the
# name differs (toranon/tor) — change the User/Group lines accordingly.
#
# This unit replaces the tor package's own tor.service; do not enable both
# (two tors on the same DataDirectory). Install:
#   sudo install -m 0644 infra/systemd/zifiri-tor.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now zifiri-tor

[Unit]
Description=zifiri onion service (tor, hardened)
Documentation=file:///opt/zifiri/infra/harden.md
After=network-online.target
Wants=network-online.target
# nginx's onion listener (127.0.0.1:8081) opens independently of tor; if tor
# goes down the clearnet side keeps working.

[Service]
Type=simple
User=debian-tor
Group=debian-tor
# --RunAsDaemon 0: stay in the foreground, let systemd track the process (no double fork).
ExecStart=/usr/bin/tor -f /opt/zifiri/infra/tor/config/torrc --RunAsDaemon 0
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# --- hardening -----------------------------------------------------------
NoNewPrivileges=yes
# No capabilities: tor opens 9050 on loopback (>1024), no privilege needed.
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# The only write path: the onion key and tor state. The key is written to disk —
# without encryption (LUKS) this directory is readable; harden.md §LUKS.
ReadWritePaths=/var/lib/tor
StateDirectory=tor
StateDirectoryMode=0700
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
UMask=0077
# tor is written in C, no JIT: W^X can be enforced here.
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# No dump: if tor crashes, the in-RAM circuit state should not reach disk.
LimitCORE=0
