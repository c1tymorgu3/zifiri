# zifiri — Phoenix release. plan §5.1 (no logs), §11.4 (disk and memory).
#
# This unit is for running the release DIRECTLY on the host. The default
# deployment path is docker compose (infra/docker-compose.yml, infra/deploy.md);
# the same hardening principles apply there too. Do not use both together:
# two writers to the same SQLite file.
#
# Install (once):
#   sudo useradd --system --home /var/lib/zifiri --shell /usr/sbin/nologin zifiri
#   sudo install -d -m 0700 -o root -g root /run/zifiri-pepper
#   sudo sh -c 'umask 077; head -c 32 /dev/urandom | base64 > /run/zifiri-pepper/pepper'
#   sudo chmod 0400 /run/zifiri-pepper/pepper        # pepper does NOT live on disk, tmpfs
#   sudo install -m 0644 infra/systemd/zifiri.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now zifiri
#
# Pepper: supplied via LoadCredential. The process reads the file not under its
# own identity but from the tmpfs copy systemd allocates for this unit; the copy
# is visible only to this unit and is not written to disk. If the file is missing
# the unit does NOT start (fail-fast): a setup without a pepper is the same

[Unit]
Description=zifiri (Phoenix release)
Documentation=file:///opt/zifiri/infra/harden.md
After=network-online.target zifiri-tor.service
Wants=network-online.target zifiri-tor.service

[Service]
Type=simple
User=zifiri
Group=zifiri
WorkingDirectory=/opt/zifiri
ExecStart=/opt/zifiri/bin/zifiri start
# No ExecStop: `start` runs in the foreground, systemd sends SIGTERM to the
# process group; the BEAM shuts itself down on SIGTERM (Phoenix graceful shutdown).
KillSignal=SIGTERM
KillMode=mixed
TimeoutStartSec=60
TimeoutStopSec=30
Restart=on-failure
RestartSec=2

# --- environment ---------------------------------------------------------
# Paths match runtime.exs defaults; written EXPLICITLY here so that reading the
# unit standalone makes clear where it writes.
Environment=ZIFIRI_DB_PATH=/var/lib/zifiri/zifiri.db
Environment=ZIFIRI_ERR_LOG=/var/lib/zifiri/err.log
Environment=ZIFIRI_SOCKET=/run/zifiri/http.sock
Environment=ZIFIRI_PEPPER=%d/pepper
Environment=HOME=/var/lib/zifiri
Environment=LANG=C.UTF-8
Environment=TZ=UTC
# No distributed Erlang/EPMD: single node, no listening daemon (surface reduction).
Environment=RELEASE_DISTRIBUTION=none
# The release script writes the pid file under $RELEASE_TMP; the default
# /opt/zifiri/tmp would be READ-ONLY with ProtectSystem=strict. /run/zifiri
# is both writable and tmpfs (the pid does not land on disk).
Environment=RELEASE_TMP=/run/zifiri
# Stop Erlang from writing its own crash dump too: /dev/null + 0 seconds wait.
Environment=ERL_CRASH_DUMP=/dev/null
Environment=ERL_CRASH_DUMP_SECONDS=0
LoadCredential=pepper:/run/zifiri-pepper/pepper

RuntimeDirectory=zifiri
RuntimeDirectoryMode=0750
StateDirectory=zifiri
StateDirectoryMode=0700

# --- hardening -----------------------------------------------------------
# No new privileges at all: setuid binary, file capability, polkit — none can
# be raised from the process.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Root filesystem read-only; writes only to the two paths below + tmpfs.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/zifiri /run/zifiri
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
UMask=0077
# The application makes no outbound calls (§11.3): AF_UNIX is enough. INET/INET6
# are deliberately left open — so that if a library (DNS, telemetry) silently
# tries to open inet it doesn't crash; if you want to narrow the surface write
# only AF_UNIX and verify for a week that there are no runtime errors.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# --- BEAM JIT: W^X CANNOT BE ENFORCED ------------------------------------
# MemoryDenyWriteExecute=yes rejects, via seccomp, PROT_WRITE|PROT_EXEC over
# mmap/mprotect and granting PROT_EXEC to a writable page afterwards.
# The BEAM JIT (erts jit) does exactly this: module code is written to a
# writable page, then made executable with mprotect. If you set `yes` the
# emulator dies at startup with EPERM (something like "Failed to reallocate
# memory"); i.e. not hardening, but an outage. On an ERTS built without JIT
# (--disable-jit) `yes` is possible — this release has JIT.
MemoryDenyWriteExecute=no
# Syscall filter deliberately ABSENT: the set the BEAM uses (io_uring,
# sched_setaffinity, prctl, madvise) varies from release to release; a wrong
# filter produces silent EPERM at runtime. The surface is narrowed instead by
# NoNewPrivileges + empty capability set + read-only root.
LimitCORE=0
LimitNOFILE=4096
